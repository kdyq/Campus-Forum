# 同窗后端环境变量（真实值写在 .env，此文件只作模板，可提交）

# ---- 服务 ----
PORT=3000
NODE_ENV=development
# 测试模式：1 = 验证码只写 Redis、不实发邮件（保护邮箱额度，自动化测试用）；生产必须为 0
TEST_MODE=0
# 允许跨域的前端来源（逗号分隔）
CORS_ORIGIN=http://localhost:5173

# ---- MySQL ----
# 需先建库：CREATE DATABASE campus_forum CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DATABASE_URL="mysql://root:替换为数据库密码@localhost:3306/campus_forum"

# ---- JWT ----
# 各至少 32 字符；生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=please_change_me_at_least_32_chars_long
JWT_REFRESH_SECRET=please_change_me_at_least_32_chars_long_too
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL_DAYS=14

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379

# ---- QQ 邮箱 SMTP（发送验证码；授权码在 QQ 邮箱 设置-账户-POP3/SMTP 服务 生成）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq_number@qq.com
SMTP_PASS=your_smtp_auth_code
MAIL_FROM=同窗 <your_qq_number@qq.com>

# ---- 校园邮箱域名白名单（逗号分隔；以 . 开头表示匹配该后缀的任意子域）----
ALLOWED_EMAIL_DOMAINS=.edu.cn
